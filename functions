# Manage Python Virtual Environments
mvenv() {
    case "$1" in
        start) source "${2:-venv}/bin/activate" && echo "Activated: ${2:-venv}" ;;
        stop) deactivate 2>/dev/null && echo "Deactivated virtual environment" ;;
        "") [ -n "$VIRTUAL_ENV" ] && echo "venv active: $VIRTUAL_ENV" || echo "No venv active" ;;
        *) echo "Usage: mvenv [start [dir]|stop]" ;;
    esac
}

function work_mode
{
  if [[ ${1} == "off" ]]
  then
    dockutil --remove 'Microsoft Teams'
    dockutil --remove 'Microsoft Outlook'
  fi
  if [[ ${1} == "on" ]]
  then 
    dockutil --add '/Applications/Microsoft Teams.app'
    dockutil --add '/Applications/Microsoft Outlook.app'
  fi
}


function open_repo()
{
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local url
    url=$(git config --get remote.origin.url \
      | sed -e "s/git@/https:\/\//g" \
      | sed -e "s/com:/com\//"
    )
    open "$url"
  else
    echo 'Not inside git repository' 1>&2
    return 1
  fi
}

# copy folders easier
#usage: cpd directory_to_copy new_directory_name
function cpd(){
  cp -r $1 $2 
}


#!/bin/bash

# Function to start AWS CodePipeline execution with variables
# Example usage:
# start_codepipeline kfb-iam-deployment-planner "TARGET_ACCOUNT_ID=ALL"

start_codepipeline() {
  local pipeline_name=$1
  shift # Remove the first argument (pipeline name), rest are variables

  # Construct the variable arguments in shorthand syntax "name=value"
  local variable_args=""
  for var in "$@"; do
    variable_args+="name=$(echo $var | cut -d'=' -f1),value=$(echo $var | cut -d'=' -f2) "
  done

  # Start the CodePipeline with variables
  aws codepipeline start-pipeline-execution \
    --name "$pipeline_name" \
    --variables $variable_args
}

